# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jagofarm"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jagofarm"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Midtrans (sandbox)
MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
MIDTRANS_IS_PRODUCTION="false"

# Payment gateway aktif untuk pesanan BARU: "mayar" atau "midtrans".
# Kosong = otomatis: Mayar bila MAYAR_API_KEY diisi, lalu Midtrans, terakhir Mayar.
# Order yang sudah punya provider sendiri selalu memakainya (tidak berubah).
PAYMENT_PROVIDER="mayar"

# Mayar (opsional — provider redirect / halaman pembayaran hosted).
# Base URL otomatis: produksi https://api.mayar.id/hl/v2,
# sandbox https://api.mayar.io/hl/v2 (MAYAR_IS_SANDBOX="true").
MAYAR_API_KEY=""
MAYAR_IS_SANDBOX="true"
# Secret rahasia webhook Mayar. Daftarkan URL ini di dashboard Mayar
# (Integration -> Webhook):
#   https://<domain-anda>/api/payments/webhook/mayar?secret=<MAYAR_WEBHOOK_SECRET>
# Mayar TIDAK mengirim signature di payload, jadi permintaan tanpa secret yang
# cocok ditolak; tanpa env ini endpoint webhook membalas 503.
MAYAR_WEBHOOK_SECRET=""
# "true" = paksa satu channel pembayaran (channel harus sudah diaktifkan di
# dashboard Mayar, kalau belum Mayar membalas 400). "false" = pengguna memilih
# sendiri di halaman pembayaran.
MAYAR_RESTRICT_PAYMENT_METHOD="false"
# Override penuh base URL Mayar (untuk uji lokal / server stub). Kosong = pakai
# nilai otomatis di atas.
MAYAR_BASE_URL=""

# RajaOngkir
RAJAONGKIR_API_KEY=""
RAJAONGKIR_ORIGIN_CITY="152"

# Supabase (for storage, optional)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Email transaksional (Resend)
# RESEND_API_KEY: API key dari https://resend.com/api-keys. Kosong = email
#                 dilewati (no-op), alur order/pembayaran tetap jalan normal.
# EMAIL_FROM: alamat pengirim yang domainnya sudah diverifikasi di Resend.
RESEND_API_KEY=""
EMAIL_FROM="JagoFarm <no-reply@jagofarm.id>"
# EMAIL_DISABLED: "true" = matikan semua pengiriman email (berguna di CI/dev).
EMAIL_DISABLED="false"

# URL publik situs; dipakai pada tautan email (detail pesanan, footer).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
