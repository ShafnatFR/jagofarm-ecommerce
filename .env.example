# ==========================================================================
# Template environment JagoFarm.
# Salin file ini ke .env (isikan nilai nyata). .env dan .env.local TIDAK
# boleh di-commit — keduanya sudah di-ignore git.
#
# Aturan: setiap variabel di bawah ini benar-benar dibaca oleh kode
# (src/, prisma/, scripts/). Variabel mati (NEXTAUTH_*, GOOGLE_CLIENT_*,
# RAJAONGKIR_ORIGIN_CITY) sengaja TIDAK didokumentasikan.
# ==========================================================================

# --------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# DATABASE_URL : connection pooling (pgBouncer/transaction) untuk aplikasi.
# DIRECT_URL  : koneksi langsung, dipakai `prisma migrate`.
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@localhost:5432/jagofarm"
DIRECT_URL="postgresql://postgres:YOUR-PASSWORD@localhost:5432/jagofarm"

# --------------------------------------------------------------------------
# Supabase (storage + autentikasi)
# Login memakai Supabase Auth (bukan NextAuth/Google OAuth — otentikasi itu
# sudah tidak dipakai kode, jadi tidak ada variabel auth tambahan).
# SUPABASE_STORAGE_BUCKET : bucket untuk upload gambar produk admin.
#   Kosong = fallback "product-images".
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_STORAGE_BUCKET="product-images"

# --------------------------------------------------------------------------
# Payment — Midtrans (DINONAKTIFKAN SEMENTARA — menunggu akun Midtrans di-ACC)
#
# Provider aktif saat ini hanya Mayar (lihat PAYMENT_PROVIDER di bawah).
# Kode Midtrans (src/lib/midtrans.ts, src/lib/payments/midtrans.ts) SENGAJA
# tetap utuh supaya bisa diaktifkan tanpa menulis ulang: cukup isi key di
# bawah, set PAYMENT_PROVIDER="midtrans", lalu deploy ulang.
# Rencana aktivasi lengkap: docs/midtrans-gateway-plan.md
#
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY : opsional; kosong = dipakai
#   MIDTRANS_CLIENT_KEY.
# MIDTRANS_IS_PRODUCTION : "true" hanya untuk kredensial Midtrans produksi.
# --------------------------------------------------------------------------
# MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
# MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
# MIDTRANS_IS_PRODUCTION="false"

# Payment gateway aktif untuk pesanan BARU: "mayar" atau "midtrans".
# Kosong = otomatis: Mayar bila MAYAR_API_KEY diisi, lalu Midtrans, terakhir Mayar.
# Order yang sudah punya provider sendiri selalu memakainya (tidak berubah).
PAYMENT_PROVIDER="mayar"

# --------------------------------------------------------------------------
# Payment — Mayar (opsional — provider redirect / halaman pembayaran hosted)
# Base URL otomatis: produksi https://api.mayar.id/hl/v2,
# sandbox https://api.mayar.io/hl/v2 (MAYAR_IS_SANDBOX="true").
# MAYAR_WEBHOOK_SECRET : daftarkan URL ini di dashboard Mayar
# (Integration -> Webhook):
#   https://<domain-anda>/api/payments/webhook/mayar?secret=<MAYAR_WEBHOOK_SECRET>
# Mayar TIDAK mengirim signature di payload, jadi permintaan tanpa secret yang
# cocok ditolak; tanpa env ini endpoint webhook membalas 503.
# MAYAR_RESTRICT_PAYMENT_METHOD : "true" = paksa satu channel pembayaran
# (channel harus sudah diaktifkan di dashboard Mayar, kalau belum Mayar
# membalas 400). "false" = pengguna memilih sendiri di halaman pembayaran.
# MAYAR_BASE_URL : override penuh base URL Mayar (untuk uji lokal / server
# stub). Kosong = pakai nilai otomatis di atas.
# --------------------------------------------------------------------------
MAYAR_API_KEY=""
MAYAR_IS_SANDBOX="true"
MAYAR_WEBHOOK_SECRET=""
MAYAR_RESTRICT_PAYMENT_METHOD="false"
MAYAR_BASE_URL=""

# --------------------------------------------------------------------------
# Shipping — RajaOngkir / official courier rate provider
# RAJAONGKIR_BASE_URL : kosong = fallback https://rajaongkir.komerce.id/api/v1.
# WAREHOUSE_CITY_ID : kota asal pengiriman (kode RajaOngkir V2).
#   CATATAN: kode membaca WAREHOUSE_CITY_ID — nama lama
#   RAJAONGKIR_ORIGIN_CITY sudah tidak dipakai dan tidak ada di template ini.
#   Kosong = fallback "5099" (Sukapura, Dayeuhkolot, Bandung).
# SHIPPING_VOLUMETRIC_DIVISOR : pembagi berat volumetrik dalam cm³/kg.
#   Sesuaikan dengan paket provider yang aktif. Kosong = fallback 5000.
# --------------------------------------------------------------------------
RAJAONGKIR_API_KEY=""
RAJAONGKIR_BASE_URL=""
WAREHOUSE_CITY_ID="5099"
SHIPPING_VOLUMETRIC_DIVISOR="5000"

# --------------------------------------------------------------------------
# Email transaksional (Resend)
# RESEND_API_KEY : API key dari https://resend.com/api-keys. Kosong = email
#                  dilewati (no-op), alur order/pembayaran tetap jalan normal.
# EMAIL_FROM : alamat pengirim; domainnya harus sudah diverifikasi di Resend.
#   Kosong = fallback "JagoFarm <no-reply@jagofarm.id>".
# EMAIL_DISABLED : "true" = matikan semua pengiriman email (berguna di CI/dev).
#   Kosong = dianggap "false" (email aktif bila RESEND_API_KEY ada).
# EMAIL_ALERT_TO : alamat penerima email peringatan internal (mis. laporan
#   error webhook). Kosong = fallback ke email kontak situs.
# --------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="JagoFarm <no-reply@jagofarm.id>"
EMAIL_DISABLED="false"
EMAIL_ALERT_TO=""

# --------------------------------------------------------------------------
# Site URL
# NEXT_PUBLIC_SITE_URL : URL publik situs; dipakai sitemap.xml, robots.txt,
#   metadata, dan tautan email (detail pesanan, reset password). Kosong =
#   fallback http://localhost:3000.
# NEXT_PUBLIC_APP_URL : URL situs/komunitas pada footer konfigurasi situs.
#   Kosong = fallback https://jagofarm.dev/.
# --------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="https://jagofarm.dev/"
